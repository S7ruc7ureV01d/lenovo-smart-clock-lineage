# Android fstab file.
# <src>                                           <mnt_point>  <type> <mnt_flags and options>                       <fs_mgr_flags>
# Stock used "avb" on system/vendor/oem; dropped because vbmeta ships with
# verification disabled (--flags 3).
/dev/block/platform/bootdevice/by-name/system     /             ext4  ro,barrier=1                                  wait,slotselect
/dev/block/platform/bootdevice/by-name/vendor     /vendor       ext4  ro,barrier=1                                  wait,slotselect
/dev/block/platform/bootdevice/by-name/userdata   /data         ext4  noatime,nosuid,nodev,noauto_da_alloc,discard  wait,check,formattable,encryptable=/dev/block/platform/bootdevice/by-name/metadata
/dev/block/platform/bootdevice/by-name/factory    /mnt/product/factory ext4  ro,barrier=1,discard,nosuid,nodev,noexec,context=u:object_r:factoryfs:s0  wait,nofail
/dev/block/platform/bootdevice/by-name/oem        /oem          ext4  ro,nosuid,nodev                               wait,slotselect,nofail
/dev/block/platform/bootdevice/by-name/misc       /misc         emmc  defaults                                      defaults
/dev/block/platform/bootdevice/by-name/boot       /boot         emmc  defaults                                      slotselect
/dev/block/platform/bootdevice/by-name/vbmeta     /vbmeta       emmc  ro                                            wait,slotselect
/devices/platform/soc/mt_usb*                     auto          vfat  defaults                                      voldmanaged=usbotg:auto
/dev/block/zram0                                  none          swap  defaults                                      zramsize=50%
