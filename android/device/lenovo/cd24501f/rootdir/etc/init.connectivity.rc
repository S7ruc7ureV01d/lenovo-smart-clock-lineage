# MTK connectivity .rc configure

on post-fs-data


#
# Connectivity related device nodes & configuration (begin)
#
    chown bluetooth bluetooth /dev/stpbt
    chmod 0660   /dev/stpbt


#/dev/ttyMT2 for Connectivity BT/FM/GPS usage
    chmod 0660 /dev/ttyMT2
    chown system system /dev/ttyMT2

# WiFi
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/wpa_supplicant 0770 wifi wifi
    mkdir /data/vendor/wifi 0771 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

# BT relayer mode used VCOM
    chown bluetooth bluetooth /dev/ttyGS2
    chmod 0660 /dev/ttyGS2

#
# Connectivity related device nodes & configuration (end)
#


# Stock's wmt_loader only insmods these from hardcoded stock paths
# (/system/lib/modules/4.4.95+/kernel/...); the build installs them flat to
# /vendor/lib/modules
on post-fs
    insmod /vendor/lib/modules/wlan_drv_gen4_mt7668.ko
    insmod /vendor/lib/modules/btmtksdio.ko

#
# Connectivity related services (Begin)
#

# Pie's framework drives the supplicant over HIDL (adds wlan0/p2p0 itself),
# so use the AOSP-style service rather than stock's -i/-c command line
service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
    -O/data/vendor/wifi/wpa/sockets -puse_p2p_group_interface=1 \
    -g@android:wpa_wlan0
    interface android.hardware.wifi.supplicant@1.0::ISupplicant default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant default
    socket wpa_wlan0 dgram 660 wifi wifi
    class main
    disabled
    oneshot

#
# Connectivity related services (End)
#

